# Copy this file to .env and fill in local values.
# Do NOT commit the real .env file.
# Never put API keys in frontend code or frontend env files.

DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/product_compliance

# Optional LLM settings (backend only)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# EVALUATION_USE_LLM=true

# Auth (backend only) — REQUIRED for register/login/session cookies.
# Copy to backend/.env and replace with a long random string.
# Do NOT commit the real secret.
AUTH_SECRET_KEY=change-me-in-local-env
# AUTH_COOKIE_NAME=pca_access_token
# AUTH_TOKEN_EXPIRE_MINUTES=10080
# AUTH_COOKIE_SECURE=false
# AUTH_COOKIE_SAMESITE=lax

# Optional: used only by scripts/create_admin.py (do not commit real values)
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
